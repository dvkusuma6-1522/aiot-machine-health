/**
 * @file secrets.h.example
 * @brief Template for Wi-Fi Credentials and Backend Server URL
 *
 * Copy this file to secrets.h and customize with your local network settings.
 * NEVER commit secrets.h to public version control.
 */

#ifndef ENV_SECRETS_H
#define ENV_SECRETS_H

// --- Wi-Fi Network Credentials ---
#define WIFI_SSID           "YOUR_WIFI_SSID"
#define WIFI_PASSWORD       "YOUR_WIFI_PASSWORD"

// --- FastAPI Environmental Backend URL ---
// Replace with your host machine's IP address on the local network (e.g. 192.168.1.100)
#define BACKEND_BASE_URL    "http://192.168.1.100:8000"
#define TELEMETRY_ENDPOINT  "/api/v1/environment/telemetry"

// Wi-Fi Connection Timeout
#define WIFI_TIMEOUT_MS     10000

// --- Blynk IoT Cloud Configuration ---
// Obtain these from your Blynk.Console Device info:
#define BLYNK_TEMPLATE_ID   "TMPLxxxxxx"
#define BLYNK_TEMPLATE_NAME "AI Environmental Monitor"
#define BLYNK_AUTH_TOKEN    "YOUR_BLYNK_AUTH_TOKEN"

#endif // ENV_SECRETS_H
