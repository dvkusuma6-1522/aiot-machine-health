/**
 * @file secrets.h.example
 * @brief Template for Wi-Fi credentials and Backend URL
 * 
 * Copy this file to "secrets.h" in the same directory and fill in your actual
 * Wi-Fi SSID, Password, and FastAPI backend endpoint.
 * "secrets.h" is ignored by git to keep your credentials private.
 */

#ifndef SECRETS_H
#define SECRETS_H

// Local Wi-Fi Network Credentials
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// FastAPI Backend Telemetry Endpoint URL
// Replace with the IP address of the machine running the backend:
// Example: "http://192.168.1.150:8000/api/v1/telemetry"
#define BACKEND_API_URL "http://192.168.1.100:8000/api/v1/telemetry"

#endif // SECRETS_H
