# ==============================================================================
# AIoT Machine Health Monitoring System Environment Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit actual passwords, Wi-Fi credentials, or secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Defaults to SQLite for local development; use PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/machine_health.db
# DATABASE_URL=postgresql+asyncpg://aiot_user:aiot_password@localhost:5432/aiot_machine_health

# Vibration Sampling & Windowing Parameters
VIBRATION_SAMPLING_RATE_HZ=200
VIBRATION_WINDOW_SIZE=256
VIBRATION_WINDOW_OVERLAP_PERCENT=50

# Machine Learning & Anomaly Thresholds
LSTM_MODEL_PATH=./models/lstm_autoencoder.pt
XGB_MODEL_PATH=./models/xgboost_fault_classifier.json
ANOMALY_THRESHOLD_PERCENTILE=99.0

# Safety & Relay Protection Configuration
AUTO_SHUTDOWN_ENABLED=False
RELAY_COOLDOWN_SECONDS=60
CRITICAL_HEALTH_THRESHOLD=60.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ==============================================================================
# Blynk IoT Cloud Configuration (Environmental Monitoring)
# ==============================================================================
# Set your Blynk Device Auth Token from Blynk.Console to enable Cloud synchronization.
# If left empty, the system operates in local offline alerting mode without error.
BLYNK_AUTH_TOKEN=
BLYNK_SERVER_URL=https://blynk.cloud/external/api
BLYNK_ENABLED=False

# Environmental Alert Thresholds & Cooldowns
ALERT_MQ135_THRESHOLD_VOLTS=2.0
ALERT_TEMP_HIGH_C=35.0
ALERT_BIN_FULL_PERCENT=80.0
ALERT_COOLDOWN_SECONDS=300

